(program
  (fun_def int main [int x, bool flag]
    (block
      (declare result int
        (block
          (assign result ((flag ? (> x 0) : false) ? x : 0))
          (if (!= result 0)
            (then (block
              (assign result (+ (LValue result) 1))
            ))
            (else (block
              (assign result 1)
            )))
          (return result)
        ))
    ))
)
