typedef int A;
A pow(int b, int e) {
  if (e == 0) {
    return 1;
  } else {
    return b * pow(b, e - 1);
  }
}

int main() {
  // computes 1*1 + 2*2 +3*3
  int sum = 0;
  for (int i = 1; i <= 3; i++) {
    sum += pow(i, 2);
  }

  assert(1*1 + 2*2 + 3*3 == 14);
  assert(sum == 14);
  return sum;
}
