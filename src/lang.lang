void map(int[] arr, fn(int) -> int f) {
  for (int i = 0; i < array_length(arr); i++) {
    arr[i] = f(arr[i]);
  }
  return;
}

int double(int x) {
  return x + x;
}

int main() {
  int[] arr = alloc_array(int, 4);
  for(int i = 0; i < array_length(arr); i++) {
    arr[i] = i + 1;
  }

  map(arr, double);

  int ret = arr[0];
  dealloc(arr);
  return ret;
}
