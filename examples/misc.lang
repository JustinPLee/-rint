typedef int Word;

Word gcd(Word a, Word b) {
    while (b != 0) {
        Word remainder = a % b;
        a = b;
        b = remainder;
    }

    return a;
}

int factorial(int n) {
    if (n <= 1) {
        return 1;
    }

    return n * factorial(n - 1);
}

bool is_between(int value, int low, int high) {
    return value >= low && value <= high;
}

int sum_eight(int a, int b, int c, int d, int e, int f, int g, int h) {
    return a + b + c + d + e + f + g + h;
}

int main() {
    int common = gcd(1071, 462);
    int fact = factorial(5);
    int total = sum_eight(1, 2, 3, 4, 5, 6, 7, 8);
    bool checks_pass = is_between(common, 20, 22)
        && fact == 120
        && total == 36;

    assert(checks_pass);

    int selected = common == 21 ? total / 4 : total % 4;
    return common + fact % 10 + selected;
}
