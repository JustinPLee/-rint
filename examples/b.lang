int main() {
        int sum = 0;

        for (int i = 0; i < 5; i = i + 1) {
            int x = i > 2 ? i : 2;

            while (x < 6) {
                if (x != 4) {
                    sum = sum + x;
                } else {
                    sum = sum + 10;
                }

                x = x + 1;
            }
        }

        return sum;
    }
